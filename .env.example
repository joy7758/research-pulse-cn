APP_OFFICIAL_ACCOUNT_REAL_SEND_ENABLED=false
APP_OFFICIAL_ACCOUNT_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=120
APP_OFFICIAL_ACCOUNT_HTTP_CONNECT_TIMEOUT_SECONDS=5
APP_OFFICIAL_ACCOUNT_HTTP_READ_TIMEOUT_SECONDS=10
APP_OFFICIAL_ACCOUNT_MAX_RETRIES=2
APP_OFFICIAL_ACCOUNT_TEMPLATE_FIELD_MAPPING_JSON=
APP_OFFICIAL_ACCOUNT_DEFAULT_MINI_PROGRAM_APP_ID=
APP_OFFICIAL_ACCOUNT_DEFAULT_ARTICLE_BASE_URL=
APP_OFFICIAL_ACCOUNT_DISPATCH_TIMEOUT_SECONDS=5

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=research_pulse_cn
POSTGRES_USER=research_pulse
