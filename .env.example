APP_NAME=Research Pulse CN
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DEBUG=false
# Optional override for local SQLite or test-only databases.
APP_DATABASE_URL=
APP_MAX_DELIVERY_RETRIES=3
APP_DELIVERY_RETRY_DELAY_SECONDS=300
APP_PULSE_STALE_DAYS=10
APP_PULSE_DEADLINE_HORIZON_DAYS=7
APP_PULSE_DEDUPE_WINDOW_HOURS=24
APP_PULSE_MIN_SCORE=10
APP_PULSE_DEFAULT_MAX_CARDS_PER_RUN=3
APP_PULSE_WEIGHT_SIGNAL_CHANGE=18
APP_PULSE_WEIGHT_STALLED_PROGRESS=12
APP_PULSE_WEIGHT_DEADLINE_RISK=5
APP_PULSE_WEIGHT_NEXT_ACTION=8
APP_PULSE_WEIGHT_RELATED_PAPER=4
APP_PULSE_MODIFIER_RECENT_SIGNAL_DELTA=8
APP_PULSE_MODIFIER_APPROACHING_DEADLINE=10
APP_PULSE_MODIFIER_LONG_STAGNATION=6
APP_PULSE_MODIFIER_EXPLICIT_NEXT_ACTION=4
APP_DEFAULT_TIMEZONE=UTC
APP_PULSE_DEFAULT_SEND_HOUR_LOCAL=9
APP_PULSE_DEFAULT_SEND_MINUTE_LOCAL=0
APP_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
APP_WORKER_LEASE_SECONDS=120
APP_AUTH_ACCESS_TOKEN_TTL_MINUTES=30
APP_AUTH_REFRESH_TOKEN_TTL_DAYS=14
# Replace these before deployment. Do not commit real secrets.
APP_AUTH_JWT_SECRET=change-me-jwt-secret
APP_AUTH_JWT_ISSUER=research-pulse-cn
APP_AUTH_JWT_AUDIENCE=research-pulse-cn-admin
APP_INTERNAL_SERVICE_TOKEN=change-me-internal-service-token
APP_SYNC_DEVICE_TOKEN_TTL_DAYS=90
APP_SYNC_FEED_DEFAULT_LIMIT=100
APP_SYNC_FEED_MAX_LIMIT=500
APP_SYNC_PUSH_MAX_BATCH_SIZE=50
APP_MINI_READ_GRANT_DEFAULT_TTL_HOURS=72
APP_MINI_PAPERS_DEFAULT_LIMIT=20
APP_MINI_PAPERS_MAX_LIMIT=100
APP_OFFICIAL_ACCOUNT_PROVIDER_MODE=disabled
APP_OFFICIAL_ACCOUNT_TRANSPORT_KIND=template_notice
APP_WECHAT_OFFICIAL_APP_ID=
APP_WECHAT_OFFICIAL_APP_SECRET=
APP_WECHAT_OFFICIAL_CALLBACK_TOKEN=
APP_WECHAT_OFFICIAL_CALLBACK_AES_KEY=
APP_WECHAT_OFFICIAL_DIGEST_TEMPLATE_ID=
